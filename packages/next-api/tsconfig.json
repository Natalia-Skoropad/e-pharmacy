{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test", "test"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "paths": {
      "@e-pharmacy/api-client/*": [
        "../api-client/src/*/index.ts",
        "../api-client/src/*.ts"
      ],
      "@e-pharmacy/config/*": [
        "../config/src/*/index.ts",
        "../config/src/*.ts"
      ],
      "@e-pharmacy/types/*": ["../types/src/*/index.ts", "../types/src/*.ts"]
    },
    "allowImportingTsExtensions": true
  }
}
