{
  "name": "@e-pharmacy/next-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./browser": "./src/browser/local-api-request.ts",
    "./server": "./src/server/public-backend-api-request.ts",
    "./proxy": "./src/proxy/index.ts",
    "./contracts": "./src/contracts/index.ts"
  },
  "scripts": {
    "lint": "eslint src test --ext .ts",
    "type-check": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "node ../../scripts/test-runners/run-tsx-tests.mjs src && node ../../scripts/test-runners/run-tsx-tests.mjs test",
    "test:integration": "node ../../scripts/test-runners/run-tsx-tests.mjs test/integration",
    "test:security": "node ../../scripts/test-runners/run-tsx-tests.mjs test/security",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:unit": "node ../../scripts/test-runners/run-tsx-tests.mjs src"
  },
  "dependencies": {
    "@e-pharmacy/api-client": "workspace:*",
    "@e-pharmacy/config": "workspace:*",
    "@e-pharmacy/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "next": "16.2.4",
    "typescript": "^5",
    "tsx": "^4.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "peerDependencies": {
    "next": ">=16"
  }
}
