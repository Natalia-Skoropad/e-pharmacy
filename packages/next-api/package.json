{
  "name": "@e-pharmacy/next-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./browser": "./src/browser/local-api-request.ts",
    "./server": "./src/server/public-backend-api-request.ts",
    "./proxy": "./src/proxy/index.ts"
  },
  "scripts": {
    "lint": "eslint src test --ext .ts",
    "type-check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node ../../scripts/run-tsx-tests.mjs src --server-only-test-loader && node ../../scripts/run-tsx-tests.mjs test --server-only-test-loader",
    "test:integration": "node ../../scripts/run-tsx-tests.mjs test/integration --server-only-test-loader",
    "test:security": "node ../../scripts/run-tsx-tests.mjs test/security --server-only-test-loader"
  },
  "dependencies": {
    "@e-pharmacy/api-client": "workspace:*",
    "@e-pharmacy/config": "workspace:*",
    "@e-pharmacy/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "next": "16.2.4",
    "typescript": "^5",
    "tsx": "^4.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "peerDependencies": {
    "next": ">=16"
  }
}
