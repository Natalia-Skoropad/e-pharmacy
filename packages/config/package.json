{
  "name": "@e-pharmacy/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./auth": "./src/auth/index.ts",
    "./cart": "./src/cart/index.ts",
    "./orders": "./src/orders/index.ts",
    "./pharmacies": "./src/pharmacies/index.ts",
    "./products": "./src/products/index.ts",
    "./product-requests": "./src/product-requests/index.ts",
    "./users": "./src/users/index.ts",
    "./notes": "./src/notes/index.ts",
    "./presentation": "./src/presentation/index.ts"
  },
  "scripts": {
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "node ../../scripts/test-runners/run-node-ts-tests.mjs test",
    "check:public-api": "node ../../scripts/checks/config/check-config-public-api.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check:boundaries": "node ../../scripts/checks/config/check-config-boundaries.mjs",
    "check:unused-exports": "node ../../scripts/checks/config/check-config-unused-exports.mjs",
    "check:contracts": "node ../../scripts/checks/config/check-config-contracts.mjs"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@e-pharmacy/types": "workspace:*"
  }
}
