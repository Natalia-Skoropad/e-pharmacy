{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@e-pharmacy/types/*": [
        "../types/src/*/index.ts",
        "../types/src/*.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
