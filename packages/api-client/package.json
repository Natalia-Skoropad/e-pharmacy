{
  "name": "@e-pharmacy/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts/index.ts",
    "./transport": "./src/transport/index.ts",
    "./response": "./src/response/index.ts"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test:unit": "node ../../scripts/test-runners/run-tsx-tests.mjs src",
    "test:integration": "node ../../scripts/test-runners/run-tsx-tests.mjs test/integration",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "check:boundaries": "node ../../scripts/checks/api-client/check-api-client-boundaries.mjs",
    "check:public-api": "node ../../scripts/checks/api-client/check-api-client-public-api.mjs",
    "check:unused-exports": "node ../../scripts/checks/api-client/check-api-client-unused-exports.mjs",
    "check:contracts": "node ../../scripts/checks/api-client/check-api-client-contracts.mjs",
    "check:routes": "node ../../scripts/checks/api-client/check-api-client-routes.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "tsx": "latest",
    "@types/node": "latest"
  },
  "dependencies": {
    "@e-pharmacy/types": "workspace:*"
  }
}
