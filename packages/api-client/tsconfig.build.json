{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@e-pharmacy/types": [
        "../types/dist/index.d.ts"
      ],
      "@e-pharmacy/types/*": [
        "../types/dist/*/index.d.ts",
        "../types/dist/*.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts"
  ]
}
