{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "@e-pharmacy/types": [
        "../types/src/index.ts"
      ],
      "@e-pharmacy/types/*": [
        "../types/src/*/index.ts",
        "../types/src/*.ts"
      ],
      "@e-pharmacy/utils/*": [
        "../utils/src/*/index.ts",
        "../utils/src/*.ts"
      ]
    }
  }
}
