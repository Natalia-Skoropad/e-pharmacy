{
  "extends": "../config/tsconfig.base.json",
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "@e-pharmacy/types": [
        "../types/src/index.ts"
      ],
      "@e-pharmacy/auth": [
        "../auth/src/index.ts"
      ],
      "@e-pharmacy/auth/*": [
        "../auth/src/*/index.ts",
        "../auth/src/*.ts"
      ],
      "@e-pharmacy/utils": [
        "../utils/src/index.ts"
      ],
      "@e-pharmacy/utils/*": [
        "../utils/src/*/index.ts",
        "../utils/src/*.ts"
      ]
    }
  }
}
