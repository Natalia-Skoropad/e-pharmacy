{
  "name": "@e-pharmacy/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./forms": "./src/forms/index.ts",
    "./data-display": "./src/data-display/index.ts",
    "./navigation": "./src/navigation/index.ts",
    "./overlays": "./src/overlays/index.ts",
    "./media": "./src/media/index.ts",
    "./layout": "./src/layout/index.ts",
    "./cabinet": "./src/cabinet/index.ts",
    "./feedback": "./src/feedback/index.ts",
    "./status-pages": "./src/status-pages/index.ts",
    "./statistics": "./src/statistics/index.ts",
    "./styles/*.css": "./src/styles/*.css"
  },
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node ../../scripts/run-node-ts-tests.mjs src",
    "test:a11y": "node ../../scripts/run-node-ts-tests.mjs src/a11y",
    "check:styles": "node ../../scripts/check-ui-style-contracts.mjs",
    "check:boundaries": "node ../../scripts/check-ui-boundaries.mjs"
  },
  "peerDependencies": {
    "clsx": ">=2.1.1",
    "lucide-react": ">=0.468.0",
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.4",
    "typescript": "^5",
    "@types/node": "latest"
  },
  "dependencies": {
    "@e-pharmacy/config": "workspace:*",
    "@e-pharmacy/hooks": "workspace:*",
    "@e-pharmacy/types": "workspace:*",
    "@e-pharmacy/utils": "workspace:*",
    "@e-pharmacy/validation": "workspace:*"
  }
}
