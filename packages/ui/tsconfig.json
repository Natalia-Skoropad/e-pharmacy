{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@e-pharmacy/hooks": [
        "../hooks/src/index.ts"
      ],
      "@e-pharmacy/hooks/*": [
        "../hooks/src/*"
      ],
      "@e-pharmacy/types": [
        "../types/src/index.ts"
      ],
      "@e-pharmacy/types/*": [
        "../types/src/*"
      ]
    }
  }
}
