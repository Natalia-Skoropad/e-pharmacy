{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@e-pharmacy/config/*": [
        "../config/src/*/index.ts",
        "../config/src/*.ts"
      ],
      "@e-pharmacy/hooks": [
        "../hooks/src/index.ts"
      ],
      "@e-pharmacy/hooks/*": [
        "../hooks/src/*"
      ],
      "@e-pharmacy/types": [
        "../types/src/index.ts"
      ],
      "@e-pharmacy/types/*": [
        "../types/src/*"
      ],
      "@e-pharmacy/utils/*": [
        "../utils/src/*/index.ts",
        "../utils/src/*.ts"
      ],
      "@e-pharmacy/validation": [
        "../validation/src/index.ts"
      ],
      "@e-pharmacy/validation/*": [
        "../validation/src/*/index.ts",
        "../validation/src/*.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  }
}
