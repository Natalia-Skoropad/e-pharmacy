{
  "name": "@e-pharmacy/types",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./auth": "./src/auth/index.ts",
    "./cart": "./src/cart/index.ts",
    "./notes": "./src/notes/index.ts",
    "./orders": "./src/orders/index.ts",
    "./pharmacies": "./src/pharmacies/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./product-requests": "./src/product-requests/index.ts",
    "./products": "./src/products/index.ts",
    "./reviews": "./src/reviews/index.ts"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint src type-tests --ext .ts",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "test": "pnpm run test:types",
    "build": "pnpm run clean && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "type": "module",
  "sideEffects": false
}
