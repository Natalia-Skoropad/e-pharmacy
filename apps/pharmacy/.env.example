NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_LEGACY_DOMAINS=
AUTH_COOKIE_SAME_SITE=lax

# Trust a provider-owned client IP header only when the deployment platform is known.
# Allowed values: none, vercel, cloudflare.
BFF_TRUSTED_PROXY_PROVIDER=none

# Shared client storefront/auth app. Pharmacy login, registration and password recovery live there.
NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:3000

# Server-only shared secret used by the Next.js BFF when requesting auth tokens.
# `pnpm dev` auto-provisions one shared local value when this variable is absent.
# Deployments must set the same explicit value in this app and apps/api.
BFF_PROXY_SECRET=
