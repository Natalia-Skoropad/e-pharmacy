NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/e-pharmacy?retryWrites=true&w=majority

JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

CLIENT_ORIGINS=http://localhost:3000
CLIENT_APP_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

# Optional: POSTs { to, subject, text } to your email sender/webhook.
# Without this value, reset emails are printed in the API console for local development.
PASSWORD_RESET_EMAIL_WEBHOOK_URL=
