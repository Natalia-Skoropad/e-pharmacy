# apps/api
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/e-pharmacy?retryWrites=true&w=majority

JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=15m
JWT_RESET_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Local development client origin.
# Used by CORS and by Origin/Referer validation for non-safe cookie-based mutations.
CLIENT_ORIGINS=http://localhost:3000

# Public client URL used for password reset links and redirects.
CLIENT_APP_URL=http://localhost:3000

# Nodemailer / SMTP provider
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-smtp-user>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM="E-PHARMACY <no-reply@your-domain.com>"

# Optional. Use only for shared parent domains, for example .example.com.
# Leave empty for separate deployment domains such as Vercel + Render.
AUTH_COOKIE_DOMAIN=

# Local development and same-origin BFF deployments can use lax.
# Use none only for intentional direct cross-site browser calls to the API.
AUTH_COOKIE_SAME_SITE=lax

# Production examples for Render
# NODE_ENV=production
# CLIENT_ORIGINS=https://e-pharmacy-client-ten.vercel.app
# CLIENT_APP_URL=https://e-pharmacy-client-ten.vercel.app
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SAME_SITE=lax

# The API also supports aliases that may already exist in Render:
# CORS_ORIGIN=https://e-pharmacy-client-ten.vercel.app
# CLIENT_URL=https://e-pharmacy-client-ten.vercel.app
# FRONTEND_URL=https://e-pharmacy-client-ten.vercel.app
# FRONTEND_DOMAIN=https://e-pharmacy-client-ten.vercel.app
