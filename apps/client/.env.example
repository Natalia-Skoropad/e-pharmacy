# apps/client
# Local development

# Public client URL used for metadata, canonical URLs, sitemap and robots output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API base URL used only by Next.js server-side data fetching and BFF route handlers.
# Browser flows must call same-origin /api/* routes, not this URL directly.
API_BASE_URL=http://localhost:4000

# Production examples for Vercel
# NEXT_PUBLIC_SITE_URL=https://e-pharmacy-client-ten.vercel.app
# API_BASE_URL=https://e-pharmacy-api-pbaz.onrender.com

# Server-owned auth cookie settings used by Next.js BFF route handlers.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_LEGACY_DOMAINS=
AUTH_COOKIE_SAME_SITE=lax

# Trust a provider-owned client IP header only when the deployment platform is known.
# Allowed values: none, vercel, cloudflare.
BFF_TRUSTED_PROXY_PROVIDER=none

# Optional shared secret sent only by Next.js BFF route handlers to the Express API.
# Set the same value in apps/client and apps/api for production deployments.
BFF_PROXY_SECRET=

# Pharmacy application base URL used after pharmacy login/register.
# Production requirements: HTTPS, no credentials/query/hash, and a different origin from the client app.
# Base paths are supported, for example: https://apps.example.com/pharmacy-app
NEXT_PUBLIC_PHARMACY_APP_URL=http://localhost:3002
