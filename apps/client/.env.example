# apps/client
# Local development

# Public client URL used for metadata, canonical URLs, sitemap and robots output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API base URL used only by Next.js server-side data fetching and BFF route handlers.
# Browser flows must call same-origin /api/* routes, not this URL directly.
API_BASE_URL=http://localhost:4000

# Production examples for Vercel
# NEXT_PUBLIC_SITE_URL=https://e-pharmacy-client-ten.vercel.app
# API_BASE_URL=https://e-pharmacy-api-pbaz.onrender.com

# Optional shared auth-hint cookie settings for subdomain deployments.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_AUTH_COOKIE_SAME_SITE=lax

# Optional shared secret sent only by Next.js BFF route handlers to the Express API.
# Set the same value in apps/client and apps/api for production deployments.
BFF_PROXY_SECRET=
