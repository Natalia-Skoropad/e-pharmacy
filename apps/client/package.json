{
  "name": "@e-pharmacy/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && tsc --noEmit",
    "test": "node ../../scripts/test-runners/run-node-ts-tests.mjs src --match=.test.ts",
    "test:react": "node ../../scripts/test-runners/run-node-ts-tests.mjs src --match=.react.test.tsx",
    "test:integration": "node ../../scripts/test-runners/run-node-ts-tests.mjs src --match=.integration.test.ts"
  },
  "dependencies": {
    "@e-pharmacy/api-client": "workspace:*",
    "@e-pharmacy/auth": "workspace:*",
    "@e-pharmacy/config": "workspace:*",
    "@e-pharmacy/hooks": "workspace:*",
    "@e-pharmacy/next-api": "workspace:*",
    "@e-pharmacy/types": "workspace:*",
    "@e-pharmacy/ui": "workspace:*",
    "@e-pharmacy/utils": "workspace:*",
    "@e-pharmacy/validation": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5"
  }
}
